! One thermostat for all zones: the xlsx gives the set point schedules for all zones but excepts Core_Retail (heating) and Front_Entry (cooling), and the template needs both for every zone.
! HVAC system type of every zone from the xlsx (Zone and HVAC System Summary, HVAC System Type Dictionary): 3 PSZ-AC (packaged rooftop air conditioner with a gas furnace) for the four retail zones, 9 heating and ventilation (gas-fired warm air furnace, no cooling) for the entry. The xlsx names the HVAC system of each zone (raw_data column I). All equipment data are EnergyPlus defaults.
  HVACTemplate:Thermostat,
    RetailThermostat,             !- Name
    HTGSETP_SCH_NO_OPTIMUM,       !- Heating Setpoint Schedule Name  Source: xlsx Schedule Summary 'Heating Set Point', rows 101/102/103 (Mon - Fri/Sat/Sun).
    ,                             !- Constant Heating Setpoint
    CLGSETP_SCH_NO_SETBACK;       !- Cooling Setpoint Schedule Name  Source: xlsx Schedule Summary 'Cooling Set Point', rows 98/99/100 (Mon - Fri/Sat/Sun).

  HVACTemplate:System:Unitary,
    PSZ-AC:1,                     !- Name  Source: xlsx raw_data!I415 HVAC System Name = PSZ-AC:1.
    HVACOperationSchd,            !- System Availability Schedule Name  Source: xlsx Schedule Summary 'HVAC', rows 89/90/91 (Mon - Fri/Sat/Sun).
    Back_Space,                   !- Control Zone or Thermostat Location Name
    ,                             !- Supply Fan Maximum Flow Rate
    ,                             !- Supply Fan Operating Mode Schedule Name
    ,                             !- Supply Fan Total Efficiency
    ,                             !- Supply Fan Delta Pressure
    ,                             !- Supply Fan Motor Efficiency
    ,                             !- Supply Fan Motor in Air Stream Fraction
    ,                             !- Cooling Coil Type
    ,                             !- Cooling Coil Availability Schedule Name
    ,                             !- Cooling Design Supply Air Temperature
    ,                             !- Cooling Coil Gross Rated Total Capacity
    ,                             !- Cooling Coil Gross Rated Sensible Heat Ratio
    ,                             !- Cooling Coil Gross Rated COP
    Gas,                          !- Heating Coil Type  Source: xlsx HVAC System Type 3 (gas furnace): HVAC System Type Dictionary row 5; Zone and HVAC System Summary column G row 63.
    ,                             !- Heating Coil Availability Schedule Name
    ,                             !- Heating Design Supply Air Temperature
    ,                             !- Heating Coil Capacity
    ,                             !- Gas Heating Coil Efficiency
    ,                             !- Gas Heating Coil Parasitic Electric Load
    ,                             !- Maximum Outdoor Air Flow Rate
    ,                             !- Minimum Outdoor Air Flow Rate
    ,                             !- Minimum Outdoor Air Schedule Name
    NoEconomizer;                 !- Economizer Type

