! DOE Stand-alone Retail, 90.1-2004, Buffalo: only the data of the input documents (xlsx = PNNL_Prototype_Scorecards.xlsx, PDF = NREL reference-building report).
! Weather file: USA_NY_Buffalo.Niagara.Intl.AP.725280_TMY3.epw (xlsx sheet Climate Zone).

  Version,
    23.1;                         !- Version Identifier    Required by EnergyPlus

  Building,
    RetailStandalone;             !- Name  Source: xlsx raw_data column D Prototype Building = RetailStandalone; Building Summary F3 = Stand-alone Retail.

  SimulationControl,
    Yes,                          !- Do Zone Sizing Calculation
    Yes;                          !- Do System Sizing Calculation

  RunPeriod,
    Annual,                       !- Name
    1,                            !- Begin Month
    1,                            !- Begin Day of Month
    2017,                         !- Begin Year  Not in the documents: the run year is set by run_conditions.txt
    12,                           !- End Month
    31,                           !- End Day of Month
    2017;                         !- End Year  Not in the documents: the run year is set by run_conditions.txt

  SizingPeriod:WeatherFileConditionType,
    Summer,                       !- Name
    SummerExtreme;                !- Period Selection

  SizingPeriod:WeatherFileConditionType,
    Winter,                       !- Name
    WinterExtreme;                !- Period Selection

  GlobalGeometryRules,
    UpperLeftCorner,              !- Starting Vertex Position
    Counterclockwise,             !- Vertex Entry Direction
    Relative;                     !- Coordinate System

! Schedules: xlsx sheet Schedule Summary (24 hourly values for Mon-Fri, Sat, Sun). The day types SummerDesignDay and WinterDesignDay (needed by sizing) are listed with the first weekday clause: the sizing days use the Mon-Fri values.
