! DOE Mid-rise Apartment, 90.1-2004, Buffalo: only the data of the input documents (xlsx = PNNL_Prototype_Scorecards.xlsx, PDF = NREL reference-building report).
! Weather file: USA_NY_Buffalo.Niagara.Intl.AP.725280_TMY3.epw (xlsx sheet Climate Zone).

  Version,
    23.1;                         !- Version Identifier

  Building,
    ApartmentMidRise;             !- Name  Source: xlsx raw_data column D Prototype Building = ApartmentMidRise; Building Summary Q3 = Mid-rise Apartment.

  SimulationControl,
    Yes,                          !- Do Zone Sizing Calculation
    Yes;                          !- Do System Sizing Calculation

  RunPeriod,
    Annual,                       !- Name
    1,                            !- Begin Month
    1,                            !- Begin Day of Month
    2017,                         !- Begin Year  Not in the documents: the run year is set by run_conditions.txt
    12,                           !- End Month
    31,                           !- End Day of Month
    2017;                         !- End Year  Not in the documents: the run year is set by run_conditions.txt

  SizingPeriod:WeatherFileConditionType,
    Summer,                       !- Name
    SummerExtreme;                !- Period Selection

  SizingPeriod:WeatherFileConditionType,
    Winter,                       !- Name
    WinterExtreme;                !- Period Selection

  GlobalGeometryRules,
    LowerLeftCorner,              !- Starting Vertex Position
    Clockwise,                    !- Vertex Entry Direction
    Relative;                     !- Coordinate System

