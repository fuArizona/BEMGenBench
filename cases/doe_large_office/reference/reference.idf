! DOE Large Office, 90.1-2004, Buffalo: only the data of the input documents (xlsx = PNNL_Prototype_Scorecards.xlsx, PDF = NREL reference-building report).
! Weather file: USA_NY_Buffalo.Niagara.Intl.AP.725280_TMY3.epw (xlsx sheet Climate Zone).

  Version,
    23.1;                         !- Version Identifier

  Building,
    OfficeLarge;                  !- Name  Source: xlsx raw_data column D Prototype Building = OfficeLarge; Building Summary E3 = Large Office.

  SimulationControl,
    Yes,                          !- Do Zone Sizing Calculation
    Yes;                          !- Do System Sizing Calculation

  RunPeriod,
    Annual,                       !- Name
    1,                            !- Begin Month
    1,                            !- Begin Day of Month
    ,                             !- Begin Year
    12,                           !- End Month
    31;                           !- End Day of Month

  SizingPeriod:WeatherFileConditionType,
    Summer,                       !- Name
    SummerExtreme;                !- Period Selection

  SizingPeriod:WeatherFileConditionType,
    Winter,                       !- Name
    WinterExtreme;                !- Period Selection

  GlobalGeometryRules,
    UpperLeftCorner,              !- Starting Vertex Position
    Counterclockwise,             !- Vertex Entry Direction
    Relative;                     !- Coordinate System

