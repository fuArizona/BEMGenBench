    0,                            !- Vertex 3 Y {m}  Derived from: Y = 0 (the window lies in the south wall)
    ,                             !- vertex 3 z coordinate
    3.63369,                      !- Vertex 4 X {m}  Derived from: x2 = x1 + 3.0 = 0.63369 + 3.0 = 3.63369
