!    vav_mid_min_oa =     1.40608
!    add_ck_pacu_vav_mid = No
!    PACU_VAV_mid_ERV = No
!    PACU_VAV_mid_ERV_power = 1058.87675
!-   ===========  All central AHU objects for system:  PACU_VAV_mid ===========

  Sizing:System,
    PACU_VAV_mid,            !- AirLoop Name
    Sensible,                !- Type of Load to Size On   Default: the value equals the EnergyPlus default of this optional field.
    1.40608,                 !- Design Outdoor Air Flow Rate {m3/s}
    0.3,                     !- Central Heating Maximum System Air Flow Ratio
    7.0,                     !- Preheat Design Temperature {C}
    0.008,                   !- Preheat Design Humidity Ratio {kgWater/kgDryAir}
    12.8,                    !- Precool Design Temperature {C}
    0.008,                   !- Precool Design Humidity Ratio {kgWater/kgDryAir}
    12.8,                    !- Central Cooling Design Supply Air Temperature {C}
    12.8,                    !- Central Heating Design Supply Air Temperature {C}
    Coincident,              !- Type of Zone Sum to Use
    No,                      !- 100% Outdoor Air in Cooling   Default: the value equals the EnergyPlus default of this optional field.
    No,                      !- 100% Outdoor Air in Heating   Default: the value equals the EnergyPlus default of this optional field.
    0.0085,                  !- Central Cooling Design Supply Air Humidity Ratio {kgWater/kgDryAir}
    0.008,                   !- Central Heating Design Supply Air Humidity Ratio {kgWater/kgDryAir}   Default: the value equals the EnergyPlus default of this optional field.
    DesignDay,               !- Cooling Supply Air Flow Rate Method   Default: the value equals the EnergyPlus default of this optional field.
    0,                       !- Cooling Supply Air Flow Rate {m3/s}   Default: the value equals the EnergyPlus default of this optional field.
    ,                        !- Cooling Supply Air Flow Rate Per Floor Area {m3/s-m2}
    ,                        !- Cooling Fraction of Autosized Cooling Supply Air Flow Rate
    ,                        !- Cooling Supply Air Flow Rate Per Unit Cooling Capacity {m3/s-W}
    DesignDay,               !- Heating Supply Air Flow Rate Method   Default: the value equals the EnergyPlus default of this optional field.
    0,                       !- Heating Supply Air Flow Rate {m3/s}   Default: the value equals the EnergyPlus default of this optional field.
    ,                        !- Heating Supply Air Flow Rate Per Floor Area {m3/s-m2}
    ,                        !- Heating Fraction of Autosized Heating Supply Air Flow Rate
    ,                        !- Heating Fraction of Autosized Cooling Supply Air Flow Rate
    ,                        !- Heating Supply Air Flow Rate Per Unit Heating Capacity {m3/s-W}
    ZoneSum,                 !- System Outdoor Air Method   Default: the value equals the EnergyPlus default of this optional field.
    ,                        !- Zone Maximum Outdoor Air Fraction {dimensionless}
    ,                        !- Cooling Design Capacity Method
    ,                        !- Cooling Design Capacity {W}
    ,                        !- Cooling Design Capacity Per Floor Area {W/m2}
    ,                        !- Fraction of Autosized Cooling Design Capacity
    ,                        !- Heating Design Capacity Method
