Version,
    23.1;                         !- Version Identifier  Required by EnergyPlus
Building,
    L100AC,                       !- Name  (case name)  Required
    0,                            !- North Axis {deg}  Source: L100A_Figures.txt Figure 2-2, north at the top of the plan
    ,                             !- Terrain
    ,                             !- Loads Convergence Tolerance Value
    ,                             !- Temperature Convergence Tolerance Value
    FullInteriorAndExterior;      !- Solar Distribution  Source: L100A_Text.txt Section 2.2.9, the program calculates the interior solar distribution
Timestep,
    6;                            !- Number of Timesteps per Hour  not in the documents; 
RunPeriod,
    Annual,                       !- Name  Source: L100A_Text.txt Section 2.2.10.1, annual thermostat control, the heating season may be the entire year
    1,                            !- Begin Month  (begin and end of the year)
    1,                            !- Begin Day of Month
    ,                             !- Begin Year
    12,                           !- End Month
    31;                           !- End Day of Month
! Required by EnergyPlus; not in the documents.
GlobalGeometryRules,
    UpperLeftCorner,              !- Starting Vertex Position  Required
    Counterclockwise,             !- Vertex Entry Direction
    World;                        !- Coordinate System

! ===========  SITE  ===========
Site:Location,
    Colorado Springs CO,          !- Name  Source: L100A_Text.txt Section 2.2.5, Colorado Springs, Colorado
    38.82,                        !- Latitude {deg}  Not in the documents; value of the EPW header. EnergyPlus ignores it in a run with a weather file (it takes the location from the EPW header)
    -104.72,                      !- Longitude {deg}  Not in the documents; value of the EPW header. EnergyPlus ignores it in a run with a weather file (it takes the location from the EPW header)
    -7,                           !- Time Zone {hr}  Not in the documents; value of the EPW header. EnergyPlus ignores it in a run with a weather file (it takes the location from the EPW header)
    1873;                         !- Elevation {m} [IP: 6145 ft]  Source: L100A_Text.txt Section 2.2.5 and Table 2-3, altitude 6145 ft. EnergyPlus ignores it in a run with a weather file; the EPW header says 1872 m

