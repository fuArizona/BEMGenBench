    190.265;                      !- Surface Area {m2} [IP: 2048 ft2]  Source: L100A_Text.txt Table 2-5 (8 ft x 128 ft = 1024 ft2, one side) and Table 2-3 (heat capacity 1425 Btu/F): both faces of the wall, 2 x 1024 ft2 = 2048 ft2

! ===========  INTERNAL GAINS AND AIR EXCHANGE  ===========
! No people, no lights: the documents give one aggregate load; there is none in the attic.
ElectricEquipment,
    Internal Gains,               !- Name
    Conditioned Zone,             !- Zone Name
    Internal Gains Sched,         !- Schedule Name  Source: L100A_Text.txt Table 2-11, hourly schedule
    EquipmentLevel,               !- Design Level Calculation Method
    833.56,                       !- Design Level {W} [IP: 2844.2 Btu/h]  Source: L100A_Text.txt Table 2-4 and 2-11, daily gains 56105 + 12156 = 68261 Btu/day, divided by 24 h
    ,                             !- Watts per Zone Floor Area
    ,                             !- Watts per Person
    0.17808,                      !- Fraction Latent  Source: L100A_Text.txt Table 2-4 / 2-11, latent 12156 / 68261 Btu/day
    0.57534;                      !- Fraction Radiant  Source: L100A_Text.txt Section 2.2.6 and Table 2-11 note 2, sensible load 70 % radiative: 0.7 x 56105 / 68261
ZoneInfiltration:DesignFlowRate,
    Conditioned Zone Infiltration,!- Name
    Conditioned Zone,             !- Zone Name
    Always On,                    !- Schedule Name
    AirChanges/Hour,              !- Design Flow Rate Calculation Method
    ,                             !- Design Flow Rate
    ,                             !- Flow Rate per Floor Area
    ,                             !- Flow Rate per Exterior Surface Area
    0.67;                         !- Air Changes per Hour  Source: L100A_Text.txt Section 2.2.5, Table 2-3 and 2-4, "HERS with automatic altitude adjustment" 0.67 ACH (137.5 CFM = 0.67 x 12312 ft3 / 60); EnergyPlus corrects the air density from the weather data. Not in the documents: no wind or temperature dependence (the coefficient fields are left blank = IDD defaults 1, 0, 0, 0)
ZoneInfiltration:DesignFlowRate,
    Attic Infiltration,           !- Name
    Attic,                        !- Zone Name
    Always On,                    !- Schedule Name
    AirChanges/Hour,              !- Design Flow Rate Calculation Method
    ,                             !- Design Flow Rate
    ,                             !- Flow Rate per Floor Area
    ,                             !- Flow Rate per Exterior Surface Area
    2.4;                          !- Air Changes per Hour  Source: L100A_Text.txt Table 2-4, attic infiltration 2.4 ACH, 138.5 CFM (Section 2.2.5: use it if the software allows it). Not in the documents: no wind or temperature dependence (coefficients blank = IDD defaults 1, 0, 0, 0)

! ===========  HVAC (ideal loads: pure load outputs)  ===========
ZoneControl:Thermostat,
    Conditioned Zone Thermostat,  !- Name  Needed by EnergyPlus
    Conditioned Zone,             !- Zone or ZoneList Name
    Heating Only Control,         !- Control Type Schedule Name
    ThermostatSetpoint:SingleHeating,!- Control 1 Object Type  Source: L100A_Text.txt Section 2.2.10.1, Colorado Springs is heating only: COOL = OFF
    Conditioned Zone Heating Setpoint;!- Control 1 Name
ThermostatSetpoint:SingleHeating,
    Conditioned Zone Heating Setpoint,!- Name
    Heating Setpoint;             !- Setpoint Temperature Schedule Name
ZoneHVAC:EquipmentConnections,
    Conditioned Zone,             !- Zone Name
    Conditioned Zone Equipment,   !- Zone Conditioning Equipment List Name
    Conditioned Zone Ideal Loads Supply Inlet,!- Zone Air Inlet Node or NodeList Name
    ,                             !- Zone Air Exhaust Node or NodeList Name
    Conditioned Zone Zone Air Node,!- Zone Air Node Name
    Conditioned Zone Return Outlet;!- Zone Return Air Node Name
ZoneHVAC:EquipmentList,
    Conditioned Zone Equipment,   !- Name
    SequentialLoad,               !- Load Distribution Scheme
    ZoneHVAC:IdealLoadsAirSystem, !- Zone Equipment 1 Object Type
    Conditioned Zone Ideal Loads Air System,!- Zone Equipment 1 Name
    1,                            !- Zone Equipment 1 Cooling Sequence
    1;                            !- Zone Equipment 1 Heating or No-Load Sequence
ZoneHVAC:IdealLoadsAirSystem,
    Conditioned Zone Ideal Loads Air System,!- Name  Source: L100A_Text.txt Section 2.2.10, pure load outputs, 100 % convective air system, efficiency 100 %
    ,                             !- Availability Schedule Name
    Conditioned Zone Ideal Loads Supply Inlet,!- Zone Supply Air Node Name
    ,                             !- Zone Exhaust Air Node Name
    ,                             !- System Inlet Air Node Name
    ,                             !- Maximum Heating Supply Air Temperature
    ,                             !- Minimum Cooling Supply Air Temperature
    ,                             !- Maximum Heating Supply Air Humidity Ratio
    ,                             !- Minimum Cooling Supply Air Humidity Ratio
    LimitCapacity,                !- Heating Limit
    ,                             !- Maximum Heating Air Flow Rate
    1000252,                      !- Maximum Sensible Heating Capacity {W} [IP: 3413000 Btu/h]  Source: L100A_Text.txt Section 2.2.10.2, 3413 MBtu/h (effectively infinite)
    LimitCapacity,                !- Cooling Limit
    ,                             !- Maximum Cooling Air Flow Rate
    0,                            !- Maximum Total Cooling Capacity {W}  Source: L100A_Text.txt Section 2.2.10.1, COOL = OFF
    ,                             !- Heating Availability Schedule Name
    ,                             !- Cooling Availability Schedule Name
    None,                         !- Dehumidification Control Type The documents have no humidity set point (only latent gains); None
    ,                             !- Cooling Sensible Heat Ratio
    None;                         !- Humidification Control Type  The documents have no humidity set point; None

! ===========  OUTPUT  ===========
Output:Table:SummaryReports,
    AllSummary;                   !- Report 1 Name  Results readout, not part of the documents (the reference results of the document are monthly heating energy and zone temperature)
Output:SQLite,
    SimpleAndTabular;             !- Option Type  Results readout, not part of the documents (the reference results of the document are monthly heating energy and zone temperature)
Output:Variable,
    *,                            !- Key Value  Results readout, not part of the documents (the reference results of the document are monthly heating energy and zone temperature)
    Zone Mean Air Temperature,    !- Variable Name
    Hourly;                       !- Reporting Frequency
Output:Variable,
    *,                            !- Key Value  Results readout, not part of the documents (the reference results of the document are monthly heating energy and zone temperature)
    Zone Ideal Loads Zone Total Heating Energy,!- Variable Name
    Hourly;                       !- Reporting Frequency
Output:Meter,
    DistrictHeating:Facility,     !- Key Name  Results readout, not part of the documents (the reference results of the document are monthly heating energy and zone temperature)
    Monthly;                      !- Reporting Frequency
Output:Meter,
    InteriorEquipment:Electricity,!- Key Name  Results readout, not part of the documents (the reference results of the document are monthly heating energy and zone temperature)
    Monthly;                      !- Reporting Frequency