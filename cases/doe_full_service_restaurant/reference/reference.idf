    Window,                       !- Surface Type
    Window,                       !- Construction Name
    Dining_Wall_East,             !- Building Surface Name
    ,                             !- Outside Boundary Condition Object
    ,                             !- View Factor to Ground
    ,                             !- Frame and Divider Name
    ,                             !- Multiplier
    ,                             !- Number of Vertices
