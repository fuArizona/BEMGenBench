! AlwaysOff: EnergyPlus needs a schedule for people, lights and equipment; the xlsx has no schedule for these space types (zero load).
  Schedule:Compact,
    AlwaysOff,                    !- Name
    ,                             !- Schedule Type Limits Name
    Through: 12/31,               !- Field 1
    For: AllDays,                 !- Field 2
    Until: 24:00,                 !- Field 3
    0;                            !- Field 4

  Schedule:Compact,
    Activity_Sch,                 !- Name  Source: NREL PDF Table B-12, p.97 (page 108 of the file): ACTIVITY_SCH, All, 120 for all 24 hours.
    ,                             !- Schedule Type Limits Name
    Through: 12/31,               !- Field 1
    For: AllDays,                 !- Field 2
    Until: 24:00,132;             !- Field 3

