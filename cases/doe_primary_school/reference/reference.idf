! DOE Primary School, 90.1-2004, Buffalo: only the data of the input documents (xlsx = PNNL_Prototype_Scorecards.xlsx, PDF = NREL reference-building report).
! Weather file: USA_NY_Buffalo.Niagara.Intl.AP.725280_TMY3.epw (xlsx sheet Climate Zone).

  Version,
    23.1;                         !- Version Identifier

  Building,
    SchoolPrimary;                !- Name  Source: xlsx raw_data column D Prototype Building = SchoolPrimary; Building Summary H3 = Primary School.

  SimulationControl,
    Yes,                          !- Do Zone Sizing Calculation
    Yes;                          !- Do System Sizing Calculation

  RunPeriod,
    Annual,                       !- Name
    1,                            !- Begin Month
    1,                            !- Begin Day of Month
    2017,                         !- Begin Year  Not in the documents: the run year is set by run_conditions.txt
    12,                           !- End Month
    31,                           !- End Day of Month
    2017;                         !- End Year  Not in the documents: the run year is set by run_conditions.txt

  SizingPeriod:WeatherFileConditionType,
    Summer,                       !- Name
    SummerExtreme;                !- Period Selection

  SizingPeriod:WeatherFileConditionType,
    Winter,                       !- Name
    WinterExtreme;                !- Period Selection

  GlobalGeometryRules,
    UpperLeftCorner,              !- Starting Vertex Position
    Counterclockwise,             !- Vertex Entry Direction
    Relative;                     !- Coordinate System

! Schedules: xlsx sheet Schedule Summary (24 hourly values for Mon-Fri, Sat, Sun). The three day-type clauses are the xlsx rows; the design days use the weekday clause. Occupants, Lighting and Electric Equipment have one set of rows for the study periods and one for the summer holiday: the dates of the periods (until 6/30, until 9/1, until 12/31) are those of NREL PDF Table B-8, p.87.
