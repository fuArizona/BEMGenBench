    113.44999999999999,           !- Area {m2}  Derived from: the area of the floor polygon of the surface Perimeter_ZN_3_floor (113.45 m2 = 1221.166 ft2 from the vertex coordinates).
    27.69;                        !- PerimeterExposed {m}  Derived from: the sum of the bottom edges of the 1 exterior wall that stand on the floor of the zone (Perimeter_ZN_3_wall_north): 27.69 = 27.69 m.

  Construction:FfactorGroundFloor,
    Perimeter_ZN_4_floor_Ffactor, !- Name
    1.26363,                      !- F-Factor {W/m-K}
    67.30000000000001,            !- Area {m2}  Derived from: the area of the floor polygon of the surface Perimeter_ZN_4_floor (67.3 m2 = 724.411 ft2 from the vertex coordinates).
