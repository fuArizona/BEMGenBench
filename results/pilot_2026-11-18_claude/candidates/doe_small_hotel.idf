! Small Hotel, DOE/PNNL prototype (ASHRAE 90.1-2004), Buffalo NY, EnergyPlus 23.1
! Zones and loads from the PNNL prototype scorecard (HotelSmall rows); envelope and equipment from the DOE reference building report.
Version,23.1;

SimulationControl,
  Yes,  !- Do Zone Sizing Calculation
  Yes,  !- Do System Sizing Calculation
  No,   !- Do Plant Sizing Calculation
  No,   !- Run Simulation for Sizing Periods
  Yes;  !- Run Simulation for Weather File Run Periods

Building,
  SmallHotel,  !- Name
  0,           !- North Axis {deg}
  City,        !- Terrain
  0.04,        !- Loads Convergence Tolerance Value
  0.4,         !- Temperature Convergence Tolerance Value {deltaC}
  FullInteriorAndExterior,  !- Solar Distribution
  25,          !- Maximum Number of Warmup Days
  6;           !- Minimum Number of Warmup Days

Timestep, 4;

GlobalGeometryRules,
  UpperLeftCorner,   !- Starting Vertex Position
  Counterclockwise,  !- Vertex Entry Direction
  World;             !- Coordinate System

Site:Location,
  Buffalo Niagara Intl AP NY USA,  !- Name
  42.933,  !- Latitude {deg}
  -78.733, !- Longitude {deg}
  -5.0,    !- Time Zone {hr}
  215.0;   !- Elevation {m}

RunPeriod,
  Annual,  !- Name
  1, 1,    !- Begin Month, Day
  ,        !- Begin Year
  12, 31,  !- End Month, Day
  ,        !- End Year
  Sunday,  !- Day of Week for Start Day
  Yes,     !- Use Weather File Holidays and Special Days
  Yes,     !- Use Weather File Daylight Saving Period
  No,      !- Apply Weekend Holiday Rule
  Yes,     !- Use Weather File Rain Indicators
  Yes;     !- Use Weather File Snow Indicators

SizingPeriod:DesignDay,
  Buffalo Htg 99.6% Condns DB,  !- Name
  1, 21,   !- Month, Day
  WinterDesignDay,  !- Day Type
  -15.9,   !- Maximum Dry-Bulb Temperature {C}
  0.0,     !- Daily Dry-Bulb Temperature Range {deltaC}
  ,        !- Dry-Bulb Temperature Range Modifier Type
  ,        !- Dry-Bulb Temperature Range Modifier Day Schedule Name
  Wetbulb, !- Humidity Condition Type
  -15.9,   !- Wetbulb or DewPoint at Maximum Dry-Bulb {C}
  ,        !- Humidity Condition Day Schedule Name
  ,        !- Humidity Ratio at Maximum Dry-Bulb
  ,        !- Enthalpy at Maximum Dry-Bulb
  ,        !- Daily Wet-Bulb Temperature Range
  98900.,  !- Barometric Pressure {Pa}
  4.4,     !- Wind Speed {m/s}
  260,     !- Wind Direction {deg}
  No,      !- Rain Indicator
  No,      !- Snow Indicator
  No,      !- Daylight Saving Time Indicator
  ,        !- Solar Model Indicator
  ,        !- Beam Solar Day Schedule Name
  ,        !- Diffuse Solar Day Schedule Name
  ,        !- ASHRAE Clear Sky Optical Depth for Beam Irradiance (taub) {dimensionless}
  ,        !- ASHRAE Clear Sky Optical Depth for Diffuse Irradiance (taud) {dimensionless}
  0.0;     !- Sky Clearness

SizingPeriod:DesignDay,
  Buffalo Clg 0.4% Condns DB/MCWB,  !- Name
  7, 21,   !- Month, Day
  SummerDesignDay,  !- Day Type
  30.3,    !- Maximum Dry-Bulb Temperature {C}
  8.8,     !- Daily Dry-Bulb Temperature Range {deltaC}
  DefaultMultipliers,  !- Dry-Bulb Temperature Range Modifier Type
  ,        !- Dry-Bulb Temperature Range Modifier Day Schedule Name
  Wetbulb, !- Humidity Condition Type
  21.7,    !- Wetbulb or DewPoint at Maximum Dry-Bulb {C}
  ,        !- Humidity Condition Day Schedule Name
  ,        !- Humidity Ratio at Maximum Dry-Bulb
  ,        !- Enthalpy at Maximum Dry-Bulb
  ,        !- Daily Wet-Bulb Temperature Range
  98900.,  !- Barometric Pressure {Pa}
  5.2,     !- Wind Speed {m/s}
  240,     !- Wind Direction {deg}
  No,      !- Rain Indicator
  No,      !- Snow Indicator
  No,      !- Daylight Saving Time Indicator
  ASHRAETau,  !- Solar Model Indicator
  ,        !- Beam Solar Day Schedule Name
  ,        !- Diffuse Solar Day Schedule Name
  0.45,    !- ASHRAE Clear Sky Optical Depth for Beam Irradiance (taub)
  2.05;    !- ASHRAE Clear Sky Optical Depth for Diffuse Irradiance (taud)

Sizing:Parameters,
  1.2,   !- Heating Sizing Factor
  1.2;   !- Cooling Sizing Factor

Site:GroundTemperature:BuildingSurface,
  3.39, 3.00, 4.09, 5.66, 9.61, 12.58, 14.50, 14.97, 13.77, 11.33, 8.18, 5.33;

Site:WaterMainsTemperature,
  Correlation,  !- Calculation Method
  ,             !- Temperature Schedule Name
  9.0,          !- Annual Average Outdoor Air Temperature {C}
  20.0;         !- Maximum Difference In Monthly Average Outdoor Air Temperatures {deltaC}

ScheduleTypeLimits, Fraction, 0, 1, Continuous;
ScheduleTypeLimits, Temperature, -60, 200, Continuous, Temperature;
ScheduleTypeLimits, AnyNumber;
ScheduleTypeLimits, OnOff, 0, 1, Discrete;

Schedule:Constant, AlwaysOn, OnOff, 1;
Schedule:Constant, AlwaysOff, OnOff, 0;
Schedule:Constant, FanCycling, OnOff, 0;
Schedule:Constant, ActivityLevel, AnyNumber, 120;
Schedule:Constant, WorkEff, Fraction, 0;
Schedule:Constant, AirVelocity, AnyNumber, 0.2;
Schedule:Constant, ClothingInsulation, AnyNumber, 0.7;
Schedule:Constant, HeatingControlType, AnyNumber, 1;
Schedule:Constant, WaterHeaterSetpoint, Temperature, 60;
Schedule:Constant, WaterHeaterAmbient, Temperature, 22;
Schedule:Constant, HeatingSetpointCommon, Temperature, 21.1111;

